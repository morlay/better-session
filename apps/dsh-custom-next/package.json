{
  "name": "dsh-custom-next",
  "version": "0.1.5",
  "private": true,
  "files": [
    "icon.svg",
    "justfile",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-agent-team-profile": "workspace:^",
    "@deepseek-ai/dsh-experimental-agent-team-web-profile": "workspace:^",
    "@morlay/better-session": "workspace:^",
    "@morlay/dsh-preset": "workspace:^"
  },
  "peerDependencies": {
    "tsx": "*"
  },
  "dsh": {
    "version": "workspace:^",
    "profile": {
      "bundles": [
        "@morlay/better-session",
        "@morlay/dsh-preset",
        "@deepseek-ai/dsh-experimental-agent-team-profile",
        "@deepseek-ai/dsh-experimental-agent-team-web-profile"
      ]
    },
    "desktop": {
      "id": "ai.deepseek.dsh.custom-next",
      "agentPresets": [
        "@morlay/dsh-preset/dist/presets"
      ],
      "window": {
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      },
      "icon": "icon.svg",
      "dshHome": "xdg"
    }
  }
}
