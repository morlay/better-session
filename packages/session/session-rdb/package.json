{
  "name": "@morlay/session-rdb",
  "version": "0.0.20",
  "description": "RDB durable session backend for DeepSeek Harness: implements both session-persistence and session-branch (rewind / retry / fork) providers.",
  "keywords": [
    "branch",
    "dsh",
    "dsh-plugin",
    "dsh-session-rdb",
    "rdb",
    "rewind",
    "session-rdb"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/session-rdb.git"
  },
  "files": [
    "dist",
    "src",
    "drizzle",
    "cordis.patch.yml",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./artifact": "./src/artifact.ts",
    "./deletion": "./src/deletion.ts",
    "./export": "./src/export.ts",
    "./gc": "./src/gc.ts",
    "./import": "./src/import.ts",
    "./invariant": "./src/invariant.ts",
    "./storage": "./src/storage.ts",
    "./testing": "./src/testing.ts",
    "./usage": "./src/usage.ts",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./artifact": "./dist/artifact.mjs",
      "./deletion": "./dist/deletion.mjs",
      "./export": "./dist/export.mjs",
      "./gc": "./dist/gc.mjs",
      "./import": "./dist/import.mjs",
      "./invariant": "./dist/invariant.mjs",
      "./storage": "./dist/storage.mjs",
      "./testing": "./dist/testing.mjs",
      "./usage": "./dist/usage.mjs",
      "./package.json": "./package.json",
      "./cordis.patch.yml": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && drizzle-kit generate --config drizzle.pg.config.ts"
  },
  "dependencies": {
    "@morlay/session-branch": "workspace:^",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "fflate": "^0.8.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-session-projection-cache": "workspace:^",
    "@deepseek-ai/dsh-session-turn-outline": "workspace:^",
    "@deepseek-ai/dsh-storage": "workspace:^",
    "@deepseek-ai/dsh-storage-domain": "workspace:^",
    "@deepseek-ai/dsh-token-meter": "workspace:^",
    "@deepseek-ai/dsh-workspace": "workspace:^",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5-ab785fc"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-format": "workspace:^",
    "@deepseek-ai/dsh-session-format-catalog": "workspace:^",
    "@deepseek-ai/dsh-session-persistence": "workspace:^",
    "@deepseek-ai/dsh-session-query": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "@deepseek-ai/dsh-storage": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "inlinedDependencies": {
    "@jridgewell/sourcemap-codec": "1.6.0",
    "chai": "6.2.2",
    "expect-type": "1.4.0",
    "magic-string": "1.4.1",
    "tinybench": "6.1.4",
    "vitest": "5.0.0",
    "zod": "4.6.5"
  }
}
