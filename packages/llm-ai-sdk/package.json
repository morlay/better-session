{
  "name": "@morlay/dsh-llm-ai-sdk",
  "version": "0.0.3",
  "description": "AI SDK (openai-compatible / openai / open-responses) LLM adapter plugin for DeepSeek Harness with configurable default sampling parameters over a providers dict.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm",
    "ollama",
    "openai",
    "openai-compatible",
    "open-responses",
    "ai-sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/better-session.git"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./invariant": "./src/invariant.ts",
    "./wire": "./src/wire.ts",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./invariant": "./dist/invariant.mjs",
      "./wire": "./dist/wire.mjs",
      "./package.json": "./package.json",
      "./cordis.patch.yml": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@ai-sdk/open-responses": "^2.0.38",
    "@ai-sdk/openai": "^4.0.58",
    "@ai-sdk/openai-compatible": "^3.0.32",
    "@ai-sdk/provider": "^4.0.7",
    "@deepseek-ai/dsh-util-values": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-anonymous-user-id": "workspace:^",
    "@deepseek-ai/dsh-attachment": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "@deepseek-ai/dsh-timeout": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
