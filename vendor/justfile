sync: && patch
    @if [ -d deepseek-harness ]; then rm -rf deepseek-harness; fi
    git clone --depth=1 -b dsh-v{{ env("DEEPSEEK_HARNESS_VERSION") }} https://github.com/deepseek-ai/deepseek-harness.git deepseek-harness

[working-directory("deepseek-harness")]
patch:
    rm -rf apps/cli/tests/profiles/acp/cordis.yml
    rm -rf packages/subagent/subagent-codex packages/subagent/subagent-claude-code
    sd '^.*subagent-(?:claude-code|codex).*$' '' tsconfig.host.json
    git apply ../patches/css-inline-query.patch

[working-directory("deepseek-harness")]
build:
    pnpm install
    pnpm run build
    fd -I -t d node_modules -x rm -rf
